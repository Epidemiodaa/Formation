const MPE_TITRE = 'Surveillance des maladies à potentiel épidémique (MPE) : formation d’une journée';
const MPE_DESCRIPTION = 'Reconnaître une MPE (définitions de cas, conduite à tenir, prélèvements), remplir la fiche IDS et le rapport hebdomadaire, puis tracer les courbes épidémiques. Zone sanitaire Djidja-Abomey-Agbangnizoun.';
const MPE_QUESTIONS = [{"type":"single","question":"MPE signifie :","options":["Maladies à Potentiel Épidémique","Maladies à Prise en charge Éducative","Maladies Parasitaires Endémiques"],"bonnes":[0],"donnees":{},"explication":"MPE signifie Maladies à Potentiel Épidémique."},{"type":"single","question":"Un cas suspect de rougeole présente :","options":["Une toux de plus de 3 semaines","Une fièvre avec éruption cutanée maculopapulaire","Une diarrhée sanglante isolée"],"bonnes":[1],"donnees":{},"explication":"Cas suspect de rougeole : fièvre (> 38 °C ou corps chaud) avec éruption cutanée maculopapulaire, associée ou non à une toux, un coryza ou une conjonctivite."},{"type":"single","question":"La rougeole est confirmée au laboratoire par la recherche des :","options":["Parasites dans le sang","Globules blancs","Anticorps IgM"],"bonnes":[2],"donnees":{},"explication":"La rougeole est confirmée au laboratoire par la présence d’anticorps IgM (IgM positives)."},{"type":"single","question":"Un cas suspect de shigellose est une diarrhée avec :","options":["Du sang rouge visible dans les selles","Des glaires blanches seulement","Des vomissements seulement"],"bonnes":[0],"donnees":{},"explication":"Shigellose : diarrhée accompagnée d’une présence physique de sang rouge dans les selles."},{"type":"single","question":"Quelle est la définition d’un cas de PFA (cas suspect de poliomyélite) ?","options":["Tout enfant de moins de 15 ans avec une paralysie flasque de début brutal, sans notion de traumatisme","Tout enfant de moins de 5 ans avec une fièvre et une éruption cutanée","Tout adulte avec une paralysie spastique installée depuis plus d’un mois","Tout enfant de moins de 15 ans avec une paralysie survenue après une chute ou une fracture"],"bonnes":[0],"donnees":{},"explication":"Cas de PFA (cas suspect de poliomyélite) : tout enfant de moins de 15 ans avec un trouble de la marche, une boiterie ou une paralysie flasque (même transitoire), de début brutal et sans notion de traumatisme."},{"type":"single","question":"Un cas suspect de fièvre jaune associe une fièvre brutale et :","options":["Une éruption","Une jaunisse","Une toux"],"bonnes":[1],"donnees":{},"explication":"Fièvre jaune : brusque accès de fièvre (> 38 °C) accompagné d’une jaunisse dans les 2 semaines qui suivent l’apparition des premiers symptômes."},{"type":"single","question":"Le choléra se manifeste par une diarrhée :","options":["Chronique depuis des mois","Glaireuse avec ténesme","Aqueuse aiguë"],"bonnes":[2],"donnees":{},"explication":"Choléra : diarrhée aqueuse aiguë, avec ou sans déshydratation."},{"type":"match","question":"Pour chaque maladie, indiquez le prélèvement à faire, puis le contenant (tube ou pot) à utiliser.","options":[],"bonnes":[],"donnees":{"pre":["Sang","Selles","Urines","Prélèvement de gorge"],"tubes":[{"id":"dry","t":"Tube sec (bouchon rouge)"},{"id":"edta","t":"Tube à bouchon violet"},{"id":"green","t":"Tube à bouchon vert"},{"id":"pot","t":"Pot à selles"}],"rows":[{"label":"Rougeole","p":0,"t":0},{"label":"Fièvre jaune","p":0,"t":0},{"label":"PFA","p":1,"t":3},{"label":"Shigellose","p":1,"t":3}]},"explication":"Rougeole et fièvre jaune : prélèvement de sang, dans un tube sec. PFA : deux prélèvements de selles, à 24 heures d’intervalle, dans un pot à selles. Shigellose : prélèvement de selles, dans un pot à selles. Tous les prélèvements sont acheminés au laboratoire entre +2 et +8 °C, avec la fiche IDS remplie."},{"type":"single","question":"Devant un cas suspect de MPE, il faut :","options":["Attendre la confirmation du laboratoire","Notifier immédiatement","Attendre d’avoir 3 cas"],"bonnes":[1],"donnees":{},"explication":"Cas suspect = on notifie tout de suite. On n’attend jamais la confirmation du laboratoire ni un nombre minimum de cas."},{"type":"single","question":"Quel est le circuit de la fiche IDS et de l’information ?","options":["Formation sanitaire, puis zone sanitaire, puis laboratoire national ; les résultats reviennent à la zone sanitaire puis au clinicien","Laboratoire national, puis formation sanitaire, puis zone sanitaire","Formation sanitaire, puis laboratoire national directement ; la zone sanitaire n’est informée qu’à la fin","Zone sanitaire, puis formation sanitaire, puis laboratoire national"],"bonnes":[0],"donnees":{},"explication":"La formation sanitaire détecte le cas, remplit la fiche et prélève ; la zone sanitaire reçoit la notification, investigue et envoie le prélèvement ; le laboratoire national analyse et inscrit les résultats ; ils sont renvoyés à la zone sanitaire puis au clinicien. En cas grave ou épidémique, on appelle la zone sanitaire tout de suite : la fiche suit mais ne remplace pas l’alerte."},{"type":"single","question":"À quoi sert le rapport hebdomadaire ?","options":["À remplacer la fiche IDS de chaque cas","À informer chaque semaine la zone sanitaire de la situation des maladies et événements sous surveillance dans la formation sanitaire","À confirmer les cas au laboratoire","À enregistrer les consultations de routine"],"bonnes":[1],"donnees":{},"explication":"Le rapport hebdomadaire est envoyé chaque lundi avant 10 h : il donne à la zone sanitaire la situation de la semaine (cas suspects, décès, confirmés, flambées). Il ne remplace pas la fiche IDS, qui reste individuelle."},{"type":"multi","question":"Quels éléments figurent dans le rapport hebdomadaire ?","options":["L’en-tête : département, zone sanitaire, commune, formation sanitaire, semaine","La situation de la SIMR : le tableau des maladies et événements sous surveillance","Les résultats du laboratoire pour chaque cas","La situation des décès","Le statut vaccinal de chaque patient","La situation des flambées","La situation du paludisme","Le numéro EPID de chaque cas","Le rapporteur : nom et signature"],"bonnes":[0,1,3,5,6,8],"donnees":{},"explication":"Le rapport hebdomadaire comporte : l’en-tête, la situation de la SIMR (tableau des maladies), la situation des décès, la situation des flambées, la situation du paludisme et le rapporteur (nom et signature). Les résultats du laboratoire, le statut vaccinal et le numéro EPID relèvent de la fiche IDS."},{"type":"single","question":"Combien de cas suspects de rougeole de moins de 5 ans compte-t-on dans ce registre ?","options":["2","3","4","5"],"bonnes":[1],"donnees":{"ctx":"Registre des cas suspects vus dans la formation sanitaire cette semaine :","ctxTable":{"head":["N°","Maladie","Âge","Sexe","Issue"],"rows":[[1,"Rougeole","3 ans","F","Vivant"],[2,"Choléra","30 ans","M","Vivant"],[3,"Rougeole","8 mois","M","Vivant"],[4,"Rougeole","6 ans","M","Vivant"],[5,"PFA","5 ans","M","Vivant"],[6,"Rougeole","2 ans","M","Décédé"],[7,"Shigellose","1 an","F","Vivant"],[8,"Rougeole","12 ans","F","Vivant"]]}},"explication":"Rougeole de moins de 5 ans : 3 ans (F), 8 mois (M) et 2 ans (M), soit 3 cas. Les rougeoles de 6 ans et de 12 ans sont dans la colonne 5 ans et plus ; le choléra, la PFA et la shigellose se comptent sur leur propre ligne. Le total de 5 est celui de toute la rougeole, tous âges confondus."},{"type":"rpt","question":"Quelle figure du rapport hebdomadaire est juste pour la ligne Rougeole de cette semaine ?","options":[{"rpt":[[2,2,1,1,6],[1,0,1,0,2],[0,0,0,0,0]]},{"rpt":[[2,2,1,1,6],[1,0,1,0,2],[2,2,1,1,6]]},{"rpt":[[3,2,2,1,8],[1,0,1,0,2],[0,0,0,0,0]]},{"rpt":[[2,2,1,1,6],[0,1,0,1,2],[0,0,0,0,0]]}],"bonnes":[0],"donnees":{"ctx":"Voici les cas suspects de rougeole vus cette semaine. Aucun cas n’est confirmé.","ctxTable":{"head":["N°","Âge","Sexe","Issue"],"rows":[[1,"3 ans","F","Vivant"],[2,"8 mois","M","Vivant"],[3,"6 ans","M","Décédé"],[4,"2 ans","M","Décédé"],[5,"12 ans","F","Vivant"],[6,"4 ans","F","Vivant"]]},"rptDisease":"Rougeole"},"explication":"6 cas suspects : moins de 5 ans, 2 garçons (8 mois, 2 ans) et 2 filles (3 ans, 4 ans) ; 5 ans et plus, 1 garçon (6 ans) et 1 fille (12 ans) ; total 6. Décès : 1 garçon de moins de 5 ans (2 ans) et 1 garçon de 5 ans et plus (6 ans) ; total 2. Confirmé : 0 partout. Les décès font déjà partie des cas suspects : on ne les ajoute pas."},{"type":"dates","question":"Choisissez les bonnes dates pour remplir le bloc « Histoire de la maladie » de la fiche IDS.","options":[],"bonnes":[],"donnees":{"ctx":"Un enfant de 3 ans, né le 12/05/2023, présente de la fièvre et une éruption cutanée à partir du 02/11/2026. Ses parents le conduisent au centre de santé le 04/11/2026, où l’infirmier suspecte une rougeole. Le 05/11/2026, la formation sanitaire envoie la fiche de notification à la zone sanitaire. Le prélèvement est envoyé au laboratoire le 06/11/2026.","dates":[{"k":"debut","label":"Date de début des symptômes","o":["12/05/2023","02/11/2026","04/11/2026","05/11/2026","06/11/2026"],"a":1},{"k":"consult","label":"Date de consultation","o":["12/05/2023","02/11/2026","04/11/2026","05/11/2026","06/11/2026"],"a":2},{"k":"notif","label":"Date de notification","o":["12/05/2023","02/11/2026","04/11/2026","05/11/2026","06/11/2026"],"a":3}]},"explication":"Début des symptômes : 02/11/2026. Consultation : 04/11/2026. Notification : 05/11/2026, c’est la date à laquelle la formation sanitaire envoie la fiche de notification à la zone sanitaire. Le 12/05/2023 est la date de naissance et le 06/11/2026 la date d’envoi du prélèvement au laboratoire. Les dates doivent se suivre : début, consultation, notification."},{"type":"multi","question":"Quels blocs de la fiche IDS sont remplis par la formation sanitaire ?","options":["Le bloc 1 : en-tête","Le bloc 2 : identification du cas","Le bloc 3 : histoire de la maladie","Le bloc 4 : suivi du cas","Le bloc 5 : prélèvement","Le bloc 6 : laboratoire"],"bonnes":[0,1,2,3,4],"donnees":{},"explication":"Les blocs 1 à 5 sont remplis par la formation sanitaire. Le bloc 6 (laboratoire) est rempli par le laboratoire et reste vide à la formation sanitaire."},{"type":"single","question":"Quelle est l’utilité essentielle du tracé de la courbe épidémique ?","options":["Suivre l’évolution des cas et se repérer dans le temps","Remplacer la fiche IDS","Confirmer les cas au laboratoire","Calculer la couverture vaccinale"],"bonnes":[0],"donnees":{},"explication":"La courbe épidémique permet de suivre l’évolution des cas semaine après semaine et de se repérer dans le temps : on voit si le nombre de cas augmente ou baisse."},{"type":"chart","question":"Quel dessin correspond au tracé de la courbe épidémique ?","options":[{"chart":"pie","t":"Camembert"},{"chart":"line","t":"Diagramme en ligne"},{"chart":"curve","t":"Courbe"},{"chart":"histo","t":"Histogramme (colonnes collées)"},{"chart":"bars","t":"Diagramme en barres"}],"bonnes":[3],"donnees":{"chartData":[0,1,0,2,3,5,8,11,7,4,2,1]},"explication":"La courbe épidémique se trace en histogramme : une colonne par semaine, les colonnes collées les unes aux autres, chacune remplie jusqu’à la hauteur du nombre de cas (1 carreau = 1 cas). Ce n’est ni un camembert, ni une ligne ou une courbe lissée, ni un diagramme en barres dont les barres sont séparées."},{"type":"single","question":"En semaine 8, le rapport hebdomadaire indique 11 cas suspects. Que fait-on sur la courbe épidémique ?","options":["On remplit la colonne de la semaine 8 jusqu’à 11 carreaux","On remplit la colonne 11 jusqu’à 8 carreaux","On remplit la colonne de la semaine 8 jusqu’à 8 carreaux","On ne trace rien tant que les cas ne sont pas confirmés"],"bonnes":[0],"donnees":{},"explication":"On repère la colonne de la semaine (8) et on la remplit jusqu’à la hauteur du nombre de cas : 1 carreau = 1 cas, donc 11 carreaux. On trace à partir du total des cas suspects."},{"type":"multi","question":"Pour quels événements prioritaires faut-il tracer la courbe épidémique ?","options":["Anthrax","Choléra","Décès de 5 ans et plus","Décès infantile","Décès infanto-juvénile","Décès maternel","Décès néonatals","Dengue","Dracunculose","Fièvre de Lassa","Fièvre jaune","Fièvre typhoïde","Grippe HP","Hépatites","Intoxication","Lèpre","Méningite","Morsure de chien","Mpox","Near miss","Noma","Paludisme grave","Paludisme simple","Peste","PFA","Pian","Rage","Rougeole","Shigellose","Syphilis endémique","Tétanos néonatal","Ulcère de Buruli","Zika"],"bonnes":[1,2,5,6,7,9,10,16,17,18,24,26,27,28,30],"donnees":{"fixe":true},"explication":"Les événements prioritaires pour lesquels on trace la courbe épidémique sont : choléra, méningite, fièvre jaune, tétanos néonatal, PFA, rougeole, shigellose, rage, fièvre de Lassa, dengue, mpox, morsure de chien, décès maternel, décès néonatals et décès de 5 ans et plus."}];

function adminImporterMPE(pw) { admin_(pw); return importerCoursMPE(); }
function importerCoursMPE() {
  const ex = rows_('Cours').filter(c => c.titre === MPE_TITRE)[0];
  if (ex) return { ok: true, id: S(ex.id), deja: true, message: 'Le cours MPE existe déjà (il n’a pas été importé une seconde fois).' };
  const id = id_('c');
  add_('Cours', { id, titre: MPE_TITRE, description: MPE_DESCRIPTION, actif: true });
  PHASES.forEach(phase => MPE_QUESTIONS.forEach(q => add_('Questions', { id: id_('q'), cours: id, phase, type: q.type, question: q.question,
    options: JSON.stringify(q.options), bonnes: JSON.stringify(q.bonnes), donnees: JSON.stringify(q.donnees), explication: q.explication })));
  return { ok: true, id, message: 'Cours créé avec ' + MPE_QUESTIONS.length + ' questions en pré-test et en post-test.' };
}
